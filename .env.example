# Copy this file to .env.local and fill in real keys.
# .env.local is gitignored (matches *.local) — never commit real keys.

# Groq — powers both the Reading word/sentence lookup popup and Writing feedback.
# Get a free key: https://console.groq.com -> API Keys
VITE_GROQ_API_KEY=

# Supabase — auth and database.
# Get these from your project: https://supabase.com/dashboard -> your project -> Project Settings -> API
# Use the PUBLISHABLE/anon key here — never the secret key (it must not ship to the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
