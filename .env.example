# Copy this file to .env.local and fill in real keys.
# .env.local is gitignored (matches *.local) — never commit real keys.

# Groq — powers both the Reading word/sentence lookup popup and Writing feedback.
# Get a free key: https://console.groq.com -> API Keys
# Server-side only. Deliberately NOT VITE_-prefixed: anything with that prefix
# is inlined into the browser bundle, and this key must never be. It is read by
# the /api/ai function (and by the dev server's stand-in for it).
GROQ_API_KEY=

# Optional: override the model. Providers retire models without notice —
# check https://console.groq.com/docs/models if calls start returning 404.
GROQ_MODEL=

# Supabase — auth and database.
# Get these from your project: https://supabase.com/dashboard -> your project -> Project Settings -> API
# Use the PUBLISHABLE/anon key here — never the secret key (it must not ship to the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true to browse the signed-in app without an account (local only).
VITE_DEMO_MODE=false

# OpenAI — handwriting recognition (vision) and the dictation audio that was
# generated once and now ships as static files. Server-side only.
OPENAI_API_KEY=

# Comma-separated user ids that see the link to the owner's console. Not a
# security boundary: the real check is inside the admin-stats edge function,
# against the caller's own token and a passcode. This only draws the handle.
VITE_ADMIN_IDS=

# ── Payments (Vercel only; not needed for local development) ──────────────
# From the ЮKassa dashboard once the shop is approved. Server-side only —
# никогда не с префиксом VITE_.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# The Supabase service key, used by /api/pay and /api/pay-webhook to write
# payment rows and to call confirm_payment. This bypasses row-level security
# entirely: it belongs in the Vercel dashboard and nowhere else.
SUPABASE_SERVICE_ROLE_KEY=
