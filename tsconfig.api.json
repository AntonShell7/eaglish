{
  /* The serverless functions were outside the typecheck entirely: neither
     tsconfig.app.json (which includes only `src`) nor tsconfig.node.json
     (only vite.config.ts) ever looked at them. `npx tsc -b` therefore passed
     on code that had never been checked — including the code that handles
     payments. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Matches how the host runs them: real ESM, resolved at runtime, which is
       why the imports carry a `.js` extension for a `.ts` file on disk. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
